# Copy this file to .env and fill it in. Never commit .env.

# DVR login (the same user you'd use in the DVR's web page / iVMS).
# If the password has special characters like @ # : / %, URL-encode them (e.g. @ -> %40).
FRIGATE_DVR_HOST=192.168.1.64
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PASSWORD=change-me

# Your number plate, no spaces, used for known-plate matching in Frigate's config
FRIGATE_MY_PLATE=DL3CAB1234

# Telegram bot (see README, "Create the Telegram bot")
TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Phone alarm via the free ntfy app (see README "Night alarm"). The topic name
# works like a password: keep it long and random.
NTFY_TOPIC=

# Night alarms ring the Linphone app on your phone (free sip.linphone.org accounts,
# see README "Phone call"). All three can be the same account as the phone's
# Linphone app: the Mac only dials out.
SIP_USER=
SIP_PASSWORD=
SIP_CALL_TO=

# Cloud mode only (Hik-Connect login, see README "Cloud mode"). A phone-number login
# is written as the country code + number, without +.
HIK_USER=
HIK_PASSWORD=
